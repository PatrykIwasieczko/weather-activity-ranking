generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Persisted city resolved via Open-Meteo geocoding.
/// Application code should prefer domain/repository types over this model.
model City {
  id              String   @id @default(cuid())
  openMeteoId     Int      @unique
  name            String
  latitude        Float
  longitude       Float
  countryCode     String?
  country         String?
  admin1          String?
  timezone        String?
  elevationMeters Float?
  population      Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  forecasts DailyForecast[]

  @@index([name])
}

/// Normalized daily weather + optional marine fields for one city/date.
/// Does not store raw Open-Meteo provider payloads.
model DailyForecast {
  id                 String   @id @default(cuid())
  cityId             String
  city               City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  /// Local calendar date for the forecast day (no time component).
  date               DateTime @db.Date
  /// When this forecast row was fetched from the provider.
  fetchedAt          DateTime
  temperatureMaxC    Float
  temperatureMinC    Float
  precipitationSumMm Float
  snowfallSumCm      Float
  windSpeedMaxKmh    Float
  /// Null when marine data is unavailable for the location/day.
  waveHeightMaxM     Float?
  /// Null when marine data is unavailable for the location/day.
  wavePeriodMaxS     Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([cityId, date])
  @@index([cityId, date])
}
